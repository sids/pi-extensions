+const PLANNOTATOR_UPDATE_URL = "https://api.github.com/repos/backnotprop/plannotator/releases/latest";
+const LOCAL_RELEASE_METADATA_URL = "data:application/json,%7B%22tag_name%22%3A%220.27.6%22%2C%22html_url%22%3A%22%22%7D";
+const BROWSER_HTML_REPLACEMENTS = [
+	["Ze.key!==\"Enter\"||!(Ze.metaKey||Ze.ctrlKey)", "Ze.key!==\"Enter\"||!(Ze.metaKey||Ze.ctrlKey)||!Ze.altKey"],
+	["me.key!==\"Enter\"||!(me.metaKey||me.ctrlKey)", "me.key!==\"Enter\"||!(me.metaKey||me.ctrlKey)||!me.altKey"],
+	["keys:[$o,L9]", "keys:[$o,DT,L9]"],
+	["keys:[or,Ih]", "keys:[or,u0,Ih]"],
+] as const;
+const ONBOARDING_BOOTSTRAP = `<script>
+(() => {
+	const onboardingCookies = {
+		"plannotator-plan-look-choice-resolved": "true",
+		"plannotator-look-feel-announcement-seen": "2",
+		"plannotator-guide-intro-seen": "2",
+		"plannotator-guide-hint-acked": "true",
+		"plannotator-review-setup-seen": "true",
+		"plannotator-edit-mode-announcement-seen": "3",
+		"plannotator-review-dest-spotlight-seen": "1",
+	};
+	for (const [name, value] of Object.entries(onboardingCookies)) {
+		document.cookie = \`\${name}=\${value}; path=/; max-age=31536000; SameSite=Lax\`;
+	}
+})();
+</script>`;
+
+function prepareBrowserHtml(content: string): string {
+	if (!content.includes(PLANNOTATOR_UPDATE_URL)) return content;
+	let prepared = content.replace(PLANNOTATOR_UPDATE_URL, LOCAL_RELEASE_METADATA_URL);
+	for (const [from, to] of BROWSER_HTML_REPLACEMENTS) {
+		prepared = prepared.replaceAll(from, to);
+	}
+	return prepared.replace("<head>", `<head>\n${ONBOARDING_BOOTSTRAP}`);
+}
